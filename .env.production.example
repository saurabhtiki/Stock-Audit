# Copy to .env.production and fill in (see docs/deploy.md).
# Make a SECRET_KEY with:  uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=stockaudit.example.com
CSRF_TRUSTED_ORIGINS=https://stockaudit.example.com
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=true
